diff --git a/apps/cli/tests/deployment-patches.spec.ts b/apps/cli/tests/deployment-patches.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6cf712df40aba132a114fea6729d9f18d3278026
--- /dev/null
+++ b/apps/cli/tests/deployment-patches.spec.ts
@@ -0,0 +1,221 @@
+/** Installation overlays stay last across the official CLI's boot and dump dispatch. */
+import { basename, dirname, join, relative } from 'node:path'
+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs'
+import { pathToFileURL } from 'node:url'
+import { load } from 'js-yaml'
+import {
+  composeEntries, generateConfigSchema, initProfile, loadLayeredEnv,
+} from '@deepseek-ai/dsh-app-boot'
+import { afterEach, beforeEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { runCli } from '../src/bin.ts'
+import { collectConfigDumpLayers } from '../src/dump-config.ts'
+import { prepareProfile, runProfile } from '../src/profile-boot.ts'
+import { runPlugin } from '../src/plugin.ts'
+
+const installation = vi.hoisted(() => ({ anchor: '' }))
+
+vi.mock('@deepseek-ai/dsh-app-boot', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@deepseek-ai/dsh-app-boot')>()
+  const { createLaunchEnvironmentSnapshot } = await import('@deepseek-ai/dsh-launch-environment')
+  return {
+    ...actual,
+    getDshRuntimeVersion: () => '1.2.3',
+    // Never discover the invoking directory's or the developer's credential environment.
+    loadLayeredEnv: vi.fn(() => createLaunchEnvironmentSnapshot([])),
+    generateConfigSchema: vi.fn(actual.generateConfigSchema),
+  }
+})
+vi.mock('../src/profile-boot.ts', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../src/profile-boot.ts')>()
+  // Dispatch is the subject; no application or long-lived plugin tree starts here.
+  return { ...actual, get INSTALL_ANCHOR() { return installation.anchor }, runProfile: vi.fn(async () => {}) }
+})
+vi.mock('../src/plugin.ts', () => ({ runPlugin: vi.fn(async () => 0) }))
+
+const originalArgv = process.argv
+const originalExitCode = process.exitCode
+
+beforeEach(() => {
+  // Native DLLs can stay locked until process exit; keep their cache in Git-ignored test output.
+  vi.stubEnv('NARB_NATIVE_CACHE_DIR', join(import.meta.dirname, 'tmp', 'deployment-native-cache'))
+  vi.clearAllMocks()
+  vi.spyOn(process.stdout, 'write').mockReturnValue(true)
+  vi.spyOn(process.stderr, 'write').mockReturnValue(true)
+  vi.stubGlobal('fetch', vi.fn(() => Promise.reject(new Error('CLI deployment tests are offline'))))
+})
+afterEach(() => {
+  process.argv = originalArgv
+  process.exitCode = originalExitCode
+  vi.unstubAllEnvs()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+function argv(...args: string[]): void {
+  process.argv = [process.execPath, 'installation-cli.js', ...args]
+}
+function stdout(): string {
+  return vi.mocked(process.stdout.write).mock.calls.map(([chunk]) => String(chunk)).join('')
+}
+function override(source: string, disabled: boolean): string {
+  return `- id: target\n  disabled: ${String(disabled)}\n  config: { enabled: ${String(!disabled)}, source: ${source} }\n`
+}
+
+/** Each fixture lives beside this source test, never in an ambient home or synchronized temp directory. */
+function fixture() {
+  const parent = realpathSync(import.meta.dirname)
+  const home = mkdtempSync(join(parent, '.deployment-patches-'))
+  onTestFinished(() => {
+    const target = realpathSync(home)
+    if (dirname(target) !== parent || !basename(target).startsWith('.deployment-patches-')) {
+      throw new Error('Refusing unexpected deployment fixture cleanup path')
+    }
+    rmSync(target, { recursive: true, force: true })
+  })
+  const runtime = join(home, 'installation')
+  mkdirSync(runtime)
+  installation.anchor = join(runtime, 'package.json')
+  writeFileSync(installation.anchor, '{"name":"deployment-test-runtime","version":"1.0.0"}\n')
+  vi.stubEnv('DSH_HOME', home)
+  vi.stubEnv('DSH_TELEMETRY_DISABLED', '')
+  const profile = 'deployment-fixture'
+  const dir = join(home, 'profiles', profile)
+  initProfile(dir, ['deployment-fixture-bundle'])
+  const bundle = join(dir, 'node_modules', 'deployment-fixture-bundle')
+  mkdirSync(bundle, { recursive: true })
+  writeFileSync(join(bundle, 'package.json'), JSON.stringify({
+    name: 'deployment-fixture-bundle', version: '1.0.0', type: 'module', dsh: { bundle: { patch: './cordis.patch.yml' } },
+  }))
+  const plugin = join(bundle, 'plugin.mjs')
+  writeFileSync(plugin, 'export function apply() { throw new Error("Configuration inspection must not apply plugins") }\n')
+  writeFileSync(join(bundle, 'cordis.patch.yml'), [
+    '- insert:', '    - id: target', `      name: ${JSON.stringify(pathToFileURL(plugin).href)}`,
+    '      disabled: false', '      config: { enabled: true, source: bundle }', '',
+  ].join('\n'))
+  const profilePatch = join(dir, 'cordis.patch.yml')
+  const homePatch = join(home, 'cordis.patch.yml')
+  const userPatch = join(home, 'user.yml')
+  const deployment = join(home, 'deployment.yml')
+  const finalDeployment = join(home, 'deployment-final.yml')
+  writeFileSync(profilePatch, override('profile', false))
+  writeFileSync(homePatch, override('home', false))
+  writeFileSync(userPatch, override('argv', false))
+  writeFileSync(deployment, override('deployment', false))
+  writeFileSync(finalDeployment, override('deployment-final', true))
+  const deploymentPatchFiles = Object.freeze([deployment, finalDeployment])
+  return { home, profile, dir, profilePatch, homePatch, userPatch, deployment, finalDeployment, deploymentPatchFiles }
+}
+
+describe('installation deployment patches', () => {
+  it('passes immutable deployment paths after argv overlays without changing app arguments', async () => {
+    const f = fixture()
+    const packageManager = { command: process.execPath, args: ['pnpm.mjs'], env: {} }
+    argv(f.profile, '--patch', f.userPatch, '--patch', f.deployment, 'task', '--patch', 'app-owned.yml')
+
+    await runCli({ deploymentPatchFiles: f.deploymentPatchFiles, packageManager })
+
+    expect(runProfile).toHaveBeenCalledExactlyOnceWith({
+      environment: vi.mocked(loadLayeredEnv).mock.results[0]!.value,
+      profile: f.profile,
+      fromDefaultProfile: undefined,
+      patchFiles: [f.userPatch, f.deployment, ...f.deploymentPatchFiles],
+      args: ['task', '--patch', 'app-owned.yml'],
+      packageManager,
+    })
+    expect(f.deploymentPatchFiles).toEqual([f.deployment, f.finalDeployment])
+  })
+
+  it('preserves profile dispatch without installation overlays or new launcher flags', async () => {
+    argv('custom', '--patch', 'user.yml', '--deployment-patch', 'not-a-launcher-option.yml')
+    await runCli()
+    expect(runProfile).toHaveBeenCalledWith(expect.objectContaining({
+      patchFiles: ['user.yml'], args: ['--deployment-patch', 'not-a-launcher-option.yml'],
+    }))
+  })
+
+  it('renders final deployment values after profile, home and argv attempts to enable the row', async () => {
+    const f = fixture()
+    const before = [f.profilePatch, f.homePatch, f.userPatch].map(file => readFileSync(file, 'utf8'))
+    argv(f.profile, '--patch', relative(process.cwd(), f.userPatch), '--dump-config')
+    await runCli({ deploymentPatchFiles: f.deploymentPatchFiles })
+
+    expect(load(stdout())).toEqual([expect.objectContaining({
+      id: 'target', disabled: true, config: { enabled: false, source: 'deployment-final' },
+    })])
+    expect([f.profilePatch, f.homePatch, f.userPatch].map(file => readFileSync(file, 'utf8'))).toEqual(before)
+    expect(loadLayeredEnv).not.toHaveBeenCalled()
+    expect(runProfile).not.toHaveBeenCalled()
+  })
+
+  it('retains deployment defaults without reading malformed user or home layers', async () => {
+    const f = fixture()
+    for (const file of [f.profilePatch, f.homePatch, f.userPatch]) writeFileSync(file, 'invalid: [\n')
+    argv(f.profile, '--dump-default-config')
+    await runCli({ deploymentPatchFiles: f.deploymentPatchFiles })
+
+    expect(load(stdout())).toEqual([expect.objectContaining({
+      id: 'target', disabled: true, config: { enabled: false, source: 'deployment-final' },
+    })])
+    const loaded = prepareProfile(f.profile, false)
+    const layers = collectConfigDumpLayers(loaded, true, [f.userPatch], f.deploymentPatchFiles)
+    expect(layers.map(layer => layer.label)).toEqual(['deployment-fixture-bundle', ...f.deploymentPatchFiles])
+    expect([f.profilePatch, f.homePatch, f.userPatch].map(file => readFileSync(file, 'utf8'))).toEqual([
+      'invalid: [\n', 'invalid: [\n', 'invalid: [\n',
+    ])
+  })
+
+  it.each([false, true])('preserves dump composition without deployment input (defaults=%s)', async (defaultOnly) => {
+    const f = fixture()
+    argv(f.profile, ...defaultOnly ? ['--dump-default-config'] : ['--patch', f.userPatch, '--dump-config'])
+    await runCli()
+    expect(load(stdout())).toEqual([expect.objectContaining({
+      id: 'target', disabled: false, config: { enabled: true, source: defaultOnly ? 'bundle' : 'argv' },
+    })])
+  })
+
+  it.each([false, true])('uses the same final layers for schema inspection (deployment=%s)', async (deployed) => {
+    const f = fixture()
+    argv(f.profile, '--patch', f.userPatch, '--dump-config-schema')
+    await runCli(deployed ? { deploymentPatchFiles: f.deploymentPatchFiles } : {})
+
+    expect(generateConfigSchema).toHaveBeenCalledOnce()
+    const layers = vi.mocked(generateConfigSchema).mock.calls[0]![1]
+    expect(composeEntries(layers)).toEqual([expect.objectContaining({
+      id: 'target', disabled: deployed, config: {
+        enabled: !deployed, source: deployed ? 'deployment-final' : 'argv',
+      },
+    })])
+    expect(JSON.parse(stdout())).toMatchObject({ 'x-cordis': {
+      profile: f.profile, complete: true, entries: [expect.objectContaining({ id: 'target' })],
+    } })
+    expect(loadLayeredEnv).not.toHaveBeenCalled()
+    expect(runProfile).not.toHaveBeenCalled()
+  })
+
+  it.each(['--dump-config', '--dump-default-config', '--dump-config-schema'])(
+    'rejects missing or malformed installation overlays for %s', async (flag) => {
+      const f = fixture()
+      const malformed = join(f.home, 'malformed.yml')
+      writeFileSync(malformed, 'invalid: [\n')
+      for (const file of [join(f.home, 'missing.yml'), malformed]) {
+        argv(f.profile, flag)
+        await expect(runCli({ deploymentPatchFiles: [file] })).rejects.toThrow()
+      }
+      expect(generateConfigSchema).not.toHaveBeenCalled()
+      expect(stdout()).toBe('')
+    },
+  )
+
+  it('keeps the official Desktop plugin command and package-manager invocation separate from profile overlays', async () => {
+    const f = fixture()
+    const packageManager = { command: process.execPath, args: ['pnpm.mjs'], env: {} }
+    const exit = new Error('captured CLI exit')
+    vi.spyOn(process, 'exit').mockImplementation(() => { throw exit })
+    argv('plugin', '--profile', 'desktop', 'list')
+    await expect(runCli({ manageDesktopProfile: true, deploymentPatchFiles: f.deploymentPatchFiles, packageManager }))
+      .rejects.toBe(exit)
+    expect(runPlugin).toHaveBeenCalledExactlyOnceWith('desktop', ['list'], packageManager)
+    expect(runProfile).not.toHaveBeenCalled()
+    expect(loadLayeredEnv).not.toHaveBeenCalled()
+  })
+})
