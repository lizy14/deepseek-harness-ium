index 0000000000000000000000000000000000000000..d9617bc9163ea36ef662ba17295f51d4d65544c1
--- /dev/null
+++ b/packages/experimental/inspector/tests/devtools-build.host.spec.ts
@@ -0,0 +1,73 @@
+/** Pins the DevTools build's generated source-label policy without changing legal comments or runtime exports. */
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { InlineConfig } from 'vite'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { buildFrontend } from '../scripts/devtools/vite.ts'
+
+const interceptedBuild = vi.hoisted(() => vi.fn(async (_config: InlineConfig) => ({
+  output: [{ type: 'chunk', code: '/* fixture injected script */' }],
+})))
+vi.mock('vite', async () => ({ ...await vi.importActual<typeof import('vite')>('vite'), build: interceptedBuild }))
+
+it('disables generated region labels for all DevTools builds while preserving legal comments and exports', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-devtools-source-labels-'))
+  onTestFinished(() => { rmSync(root, { recursive: true, force: true }) })
+  interceptedBuild.mockClear()
+  await buildFrontend(join(root, 'frontend'))
+  expect(interceptedBuild).toHaveBeenCalledTimes(3)
+  const configs = interceptedBuild.mock.calls.map(([config]) => config)
+  for (const config of configs) {
+    expect(config.build?.rolldownOptions?.experimental?.attachDebugInfo).toBe('none')
+    expect(config.build?.rolldownOptions?.output).toMatchObject({ comments: { legal: true } })
+  }
+  const main = configs[2]?.build
+  if (main === undefined) throw new Error('DevTools module build missing')
+  const { minify, target } = main
+  if (minify === undefined || target === undefined) throw new Error('DevTools transform options missing')
+  expect(main).toMatchObject({ minify: 'oxc', sourcemap: false, target: 'es2022', modulePreload: false })
+  expect(main.rolldownOptions?.output).toMatchObject({ chunkFileNames: 'chunks/[name]-[hash].js' })
+  const outputOptions = main.rolldownOptions?.output
+  if (outputOptions === undefined || Array.isArray(outputOptions)) throw new Error('DevTools output options missing')
+  const comments = outputOptions.comments
+  if (comments === undefined) throw new Error('DevTools legal comment options missing')
+
+  const entry = join(root, 'fixture', 'entry.js')
+  mkdirSync(join(root, 'fixture'))
+  writeFileSync(entry, 'export { answer } from "virtual-fixture"\n')
+  const virtual = '\0fixture:C:/fixture/source/labels.js'
+  const { build } = await vi.importActual<typeof import('vite')>('vite')
+  const compile = async (attachDebugInfo: 'simple' | 'none') => {
+    const result = await build({
+      configFile: false, root, publicDir: false, logLevel: 'silent',
+      plugins: [{
+        name: 'fixture-source-labels',
+        resolveId(source) { return source === 'virtual-fixture' ? virtual : null },
+        load(id) { return id === virtual ? '/*! @license DevTools fixture (MIT) */\nexport const answer = 6 * 7\n' : null },
+      }],
+      build: {
+        write: false, minify, target, sourcemap: false,
+        lib: { entry, formats: ['es'] },
+        rolldownOptions: {
+          experimental: { ...main.rolldownOptions?.experimental, attachDebugInfo },
+          output: { comments },
+        },
+      },
+    })
+    const outputs = Array.isArray(result) ? result : [result]
+    const chunks = outputs.flatMap(item => 'output' in item ? item.output.filter(output => output.type === 'chunk') : [])
+    if (chunks.length !== 1) throw new Error('Unexpected privacy fixture output')
+    return chunks[0]!.code
+  }
+  const labeled = await compile('simple')
+  expect(labeled).toMatch(/\/\/#region[^\r\n]*C:\/fixture\/source\/labels\.js/)
+  const output = await compile('none')
+  expect(output).not.toMatch(/\/\/#(?:end)?region\b/)
+  expect(output).not.toContain('C:/fixture/source/labels.js')
+  expect(output).toContain('@license DevTools fixture (MIT)')
+  const actual = await import(`data:text/javascript,${encodeURIComponent(output)}`) as { answer: number }
+  const control = await import(`data:text/javascript,${encodeURIComponent(labeled)}`) as { answer: number }
+  expect(actual.answer).toBe(control.answer)
+  expect(actual.answer).toBe(42)
+})
